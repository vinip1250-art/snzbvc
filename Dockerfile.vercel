FROM ghcr.io/gaisberg/streamnzb:latest

ENV PORT=80
ENV ADDON_PORT=80
ENV CONFIG_PATH=/tmp/data/config.json
ENV INDEXER_QUERY_HEADER=Prowlarr/2.3.0.5236
ENV INDEXER_GRAB_HEADER=SABnzbd/5.1.3

EXPOSE 80

CMD ["sh", "-c", "export ADDON_PORT=\"${PORT:-80}\"; if [ -z \"$ADDON_BASE_URL\" ]; then if [ -n \"$VERCEL_PROJECT_PRODUCTION_URL\" ]; then export ADDON_BASE_URL=\"https://${VERCEL_PROJECT_PRODUCTION_URL}\"; elif [ -n \"$VERCEL_URL\" ]; then export ADDON_BASE_URL=\"https://${VERCEL_URL}\"; fi; fi; mkdir -p \"$(dirname \"$CONFIG_PATH\")\"; exec ./streamnzb"]
