FROM ghcr.io/gaisberg/streamnzb:latest

RUN apk add --no-cache postgresql-client

ENV PORT=80
ENV ADDON_PORT=80
ENV CONFIG_PATH=/tmp/data/config.json
ENV INDEXER_QUERY_HEADER=Prowlarr/2.3.0.5236
ENV INDEXER_GRAB_HEADER=SABnzbd/5.1.3

COPY vercel-entrypoint.sh /app/vercel-entrypoint.sh
RUN chmod +x /app/vercel-entrypoint.sh

EXPOSE 80

CMD ["/app/vercel-entrypoint.sh"]
